   "source": [
    "Example 1.3 Finding the Intersection of a Plane and a Line"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "28a28766",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Titik potong: [0. 1. 0.]\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "\n",
    "# Normal vector of the plane\n",
    "n = np.array([1, 1, 5])\n",
    "\n",
    "# A point on the plane\n",
    "p1 = np.array([2, -1, 0])\n",
    "\n",
    "# A point on the line\n",
    "p2 = np.array([1, 0, 2])\n",
    "\n",
    "# Direction vector of the line\n",
    "d = np.array([-1, 1, -2])\n",
    "\n",
    "# Calculate parameter t using dot product\n",
    "numerator = np.dot(n, p1 - p2)\n",
    "denominator = np.dot(n, d)\n",
    "\n",
    "if denominator == 0:\n",
    "    if numerator == 0:\n",
    "        print(\"Garis terletak di bidang (tak hingga titik potong).\")\n",
    "    else:\n",
    "        print(\"Garis sejajar bidang dan tidak memotong.\")\n",
    "else:\n",
    "    t = numerator / denominator\n",
    "    intersection_point = p2 + t * d\n",
    "    print(\"Titik potong:\", intersection_point)\n"
   ]
  },
