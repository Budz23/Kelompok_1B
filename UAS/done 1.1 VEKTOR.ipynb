    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from mpl_toolkits.mplot3d import Axes3D\n",
    "\n",
    "# Definisi bidang: ax + by + cz + d = 0\n",
    "a, b, c, d = 1, -1, 9, 2\n",
    "n = np.array([a, b, c])\n",
    "\n",
    "# Buat meshgrid untuk bidang\n",
    "x = np.linspace(-2, 2, 20)\n",
    "y = np.linspace(-2, 2, 20)\n",
    "X, Y = np.meshgrid(x, y)\n",
    "Z = (-d - a * X - b * Y) / c\n",
    "\n",
    "# Titik p1 (di luar bidang)\n",
    "p1 = np.array([-0.5, 0.5, 2])\n",
    "\n",
    "# Titik sembarang pada bidang (p0)\n",
    "p0 = np.array([p1[0] + 1, p1[1] - 1, 0.0])\n",
    "p0[2] = (-d - a*p0[0] - b*p0[1]) / c\n",
    "\n",
    "# Hitung vektor p01 dari p1 ke p0\n",
    "p01 = p0 - p1\n",
    "\n",
    "# Vektor normal satuan\n",
    "un = n / np.linalg.norm(n)\n",
    "\n",
    "# Proyeksi p01 ke vektor normal → p21\n",
    "p21 = np.dot(p01, un) * un\n",
    "\n",
    "# Titik proyeksi p2 di bidang\n",
    "p2 = p1 + p21\n",
    "\n",
    "# Visualisasi\n",
    "fig = plt.figure(figsize=(10, 8))\n",
    "ax = fig.add_subplot(111, projection='3d')\n",
    "\n",
    "# Gambar bidang\n",
    "ax.plot_surface(X, Y, Z, alpha=0.3, color='gray', label='Plane')\n",
    "\n",
    "# Titik-titik\n",
    "ax.scatter(*p0, color='blue', label='p₀ (on plane)')\n",
    "ax.scatter(*p1, color='red', label='p₁ (off plane)')\n",
    "ax.scatter(*p2, color='green', label='p₂ (projection)', marker='^')\n",
    "\n",
    "# Vektor-vektor\n",
    "ax.quiver(*p0, *un, color='black', length=0.5, normalize=True, label='unit normal n̂')\n",
    "ax.quiver(*p1, *p01, color='orange', label='p₀₁ = p₀ - p₁')\n",
    "ax.quiver(*p1, *p21, color='purple', label='p₂₁ = projₙ(p₀₁)')\n",
    "\n",
    "# Set tampilan\n",
    "ax.set_xlabel('x')\n",
    "ax.set_ylabel('y')\n",
    "ax.set_zlabel('z')\n",
    "ax.set_title('Figure 1.16 – Projection of p₁ onto a Plane')\n",
    "ax.legend()\n",
    "ax.view_init(elev=20, azim=30)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
