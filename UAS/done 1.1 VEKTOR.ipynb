    "uz = np.array([0, 0, 1])\n",
    "O = np.array([0, 0, 0])\n",
    "\n",
    "# Basis silinder\n",
    "urho = np.cos(phi) * ux + np.sin(phi) * uy\n",
    "uphi = -np.sin(phi) * ux + np.cos(phi) * uy\n",
    "\n",
    "# Visualisasi\n",
    "fig = plt.figure(figsize=(12, 6))\n",
    "\n",
    "# ---------- (a) Basis vector urho ----------\n",
    "ax1 = fig.add_subplot(1, 2, 1, projection='3d')\n",
