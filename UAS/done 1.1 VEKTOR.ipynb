    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from mpl_toolkits.mplot3d import Axes3D\n",
    "\n",
    "# --- Definisi bidang ---\n",
    "# Bidang 1: x + y + z = 1 → normal n1 = [1,1,1]\n",
    "# Bidang 2: 2x - y + z = 0 → normal n2 = [2,-1,1]\n",
    "n1 = np.array([1, 1, 1])\n",
    "n2 = np.array([2, -1, 1])\n",
    "\n",
    "# Perkalian silang → arah garis perpotongan\n",
    "d = np.cross(n1, n2)  # arah garis perpotongan\n",
    "\n",
    "# Cari titik di garis perpotongan (dengan substitusi)\n",
    "# Misal z = 0, selesaikan sistem:\n",
    "# x + y = 1\n",
    "# 2x - y = 0 → x = 1/3, y = 2/3\n",
    "p0 = np.array([1/3, 2/3, 0])  # Titik pada garis perpotongan\n",
    "\n",
    "# --- Buat meshgrid bidang ---\n",
    "xx, yy = np.meshgrid(np.linspace(-2, 2, 20), np.linspace(-2, 2, 20))\n",
    "\n",
    "# Bidang 1: z = 1 - x - y\n",
    "z1 = 1 - xx - yy\n",
    "\n",
    "# Bidang 2: z = -2x + y\n",
    "z2 = -2*xx + yy\n",
    "\n",
    "# Garis perpotongan: r(t) = p0 + t*d\n",
    "t_vals = np.linspace(-2, 2, 100)\n",
    "line = p0.reshape(3,1) + d.reshape(3,1) * t_vals\n",
    "\n",
    "# --- Plotting ---\n",
    "fig = plt.figure(figsize=(10, 8))\n",
    "ax = fig.add_subplot(111, projection='3d')\n",
    "\n",
    "# Bidang 1\n",
    "ax.plot_surface(xx, yy, z1, alpha=0.5, color='skyblue', label='Plane 1')\n",
    "\n",
    "# Bidang 2\n",
    "ax.plot_surface(xx, yy, z2, alpha=0.5, color='lightgreen', label='Plane 2')\n",
    "\n",
    "# Garis perpotongan\n",
    "ax.plot(line[0], line[1], line[2], color='black', linewidth=3, label='Intersection Line')\n",
    "\n",
    "# Panah arah garis\n",
    "ax.quiver(*p0, *d, color='red', linewidth=2, arrow_length_ratio=0.1)\n",
    "ax.text(*p0, '  $\\\\vec{p}_0$', fontsize=12)\n",
    "ax.text(*(p0 + 0.5*d), '$\\\\vec{d}$', color='red', fontsize=12)\n",
    "\n",
    "# Sumbu dan tampilan\n",
    "ax.set_xlim(-2, 2)\n",
