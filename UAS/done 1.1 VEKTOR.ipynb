    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from mpl_toolkits.mplot3d import Axes3D\n",
    "\n",
    "# Konstanta\n",
    "mu0 = 4 * np.pi * 1e-7   # permeabilitas vakum\n",
    "I = 10                   # arus listrik dalam Ampere\n",
    "L = 1                    # setengah panjang kawat (jadi total panjang 2L)\n",
    "\n",
    "# Fungsi untuk menghitung medan H menggunakan hukum Biot–Savart\n",
    "def H_by_line_current(p, I, L, N=200):\n",
    "    rho = np.linalg.norm(p[:2])  # hanya x dan y\n",
    "    if rho < 1e-6:\n",
    "        return np.zeros(3)\n",
    "    \n",
    "    phi = np.arctan2(p[1], p[0])\n",
    "    ths = np.linspace(-np.arctan2(L, rho), np.arctan2(L, rho), N)\n",
    "    \n",
    "    dH = np.zeros(3)\n",
    "    for i in range(len(ths) - 1):\n",
    "        th = ths[i]\n",
    "        dth = ths[i+1] - th\n",
    "        z_prime = rho * np.tan(th)\n",
    "        r_vec = p - np.array([0, 0, z_prime])\n",
    "        r_mag = np.linalg.norm(r_vec)\n",
    "        if r_mag < 1e-6:\n",
    "            continue\n",
    "        dl = np.array([0, 0, rho * dth / np.cos(th)])\n",
    "        dH += np.cross(dl, r_vec) / (r_mag ** 3)\n",
    "    H = mu0 * I / (4 * np.pi) * dH\n",
    "    return H\n",
    "\n",
    "# Buat titik-titik observasi di bidang xy (z = 0), dalam pola grid\n",
    "x_vals = np.linspace(-2.5, 2.5, 11)\n",
    "y_vals = np.linspace(-2.5, 2.5, 11)\n",
    "ps = []\n",
    "for x in x_vals:\n",
    "    for y in y_vals:\n",
    "        if np.abs(x) < 0.2 and np.abs(y) < 0.2:  # hindari titik sangat dekat kawat\n",
    "            continue\n",
    "        ps.append([x, y, 0])\n",
    "ps = np.array(ps)\n",
    "\n",
    "# Hitung medan magnet H di setiap titik\n",
    "Hs = np.array([H_by_line_current(p, I, L) for p in ps])\n",
    "Hs_scaled = Hs * 6000  # skala untuk memperjelas panjang panah\n",
    "\n",
    "# Visualisasi 3D\n",
    "fig = plt.figure(figsize=(10, 8))\n",
    "ax = fig.add_subplot(111, projection='3d')\n",
    "\n",
    "# Gambar kawat di sumbu z\n",
    "ax.plot([0, 0], [0, 0], [-L, L], color='black', linewidth=3, label='Line Current (I)')\n",
    "\n",
    "# Gambar panah medan magnet H di bidang xy\n",
    "for i in range(len(ps)):\n",
    "    p = ps[i]\n",
    "    h = Hs_scaled[i]\n",
    "    ax.quiver(p[0], p[1], p[2], h[0], h[1], h[2], color='blue', length=0.3, normalize=False)\n",
    "\n",
    "# Set tampilan grafik\n",
    "ax.set_xlim([-3, 3])\n",
    "ax.set_ylim([-3, 3])\n",
    "ax.set_zlim([-1, 1])\n",
    "ax.set_xlabel('x')\n",
    "ax.set_ylabel('y')\n",
    "ax.set_zlabel('z')\n",
    "ax.set_title('Figure 1.20.1 – Magnetic Field from Finite Line Current')\n",
    "ax.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
