    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from mpl_toolkits.mplot3d import Axes3D\n",
    "\n",
    "# Parameter bola\n",
    "r = 2\n",
    "theta = np.pi / 4  # 45° zenith\n",
    "phi = np.pi / 6    # 30° azimuth\n",
    "\n",
    "# Basis Cartesian\n",
    "ux = np.array([1, 0, 0])\n",
    "uy = np.array([0, 1, 0])\n",
    "uz = np.array([0, 0, 1])\n",
    "O = np.array([0, 0, 0])\n",
    "\n",
    "# Titik P dalam koordinat bola\n",
    "P = r * np.array([\n",
    "    np.sin(theta)*np.cos(phi),\n",
    "    np.sin(theta)*np.sin(phi),\n",
    "    np.cos(theta)\n",
    "])\n",
    "\n",
    "# Basis bola dalam basis kartesian\n",
    "ur = np.sin(theta)*np.cos(phi)*ux + np.sin(theta)*np.sin(phi)*uy + np.cos(theta)*uz\n",
    "utheta = np.cos(theta)*np.cos(phi)*ux + np.cos(theta)*np.sin(phi)*uy - np.sin(theta)*uz\n",
    "uphi = -np.sin(phi)*ux + np.cos(phi)*uy\n",
    "\n",
    "# Plot 3D\n",
    "fig = plt.figure(figsize=(8, 8))\n",
    "ax = fig.add_subplot(111, projection='3d')\n",
    "\n",
    "# Sumbu Cartesian\n",
    "ax.quiver(*O, *ux, color='r', label='$\\\\vec{u}_x$')\n",
    "ax.quiver(*O, *uy, color='g', label='$\\\\vec{u}_y$')\n",
    "ax.quiver(*O, *uz, color='b', label='$\\\\vec{u}_z$')\n",
    "\n",
    "# Vektor bola\n",
    "ax.quiver(*O, *ur, color='darkred', linewidth=2, label='$\\\\vec{u}_r$')\n",
    "ax.quiver(*O, *utheta, color='green', linewidth=2, label='$\\\\vec{u}_\\\\theta$')\n",
    "ax.quiver(*O, *uphi, color='navy', linewidth=2, label='$\\\\vec{u}_\\\\phi$')\n",
    "\n",
    "# Vektor posisi ke P\n",
    "ax.quiver(*O, *P, color='gray', linestyle='dashed')\n",
    "ax.text(*P, '$P$', fontsize=12)\n",
    "\n",
    "# Proyeksi ke bidang xy\n",
    "ax.plot([0, P[0]], [0, P[1]], [0, 0], 'k--', linewidth=1)\n",
    "\n",
    "# Set axis\n",
