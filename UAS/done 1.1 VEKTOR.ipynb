     "text": [
      "Vektor Normal (tidak dinormalisasi): [-0.11111111  0.11111111  1.        ]\n",
      "Vektor Normal (satuannya): [-0.10976426  0.10976426  0.98787834]\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "\n",
    "p1 = np.array([0, 0, 2/9])\n",
    "p2 = np.array([1, 0, 1/3])\n",
    "p3 = np.array([0, 1, 1/9])\n",
    "\n",
    "v1 = p2 - p1\n",
    "v2 = p3 - p1\n",
    "\n",
    "normal_vector = np.cross(v1, v2)\n",
    "\n",
    "unit_normal = normal_vector / np.linalg.norm(normal_vector)\n",
    "\n",
    "print(\"Vektor Normal (tidak dinormalisasi):\", normal_vector)\n",
    "print(\"Vektor Normal (satuannya):\", unit_normal)\n"
   ]
