    "ax.set_zlim(-2, 2)\n",
    "ax.set_xlabel('x')\n",
    "ax.set_ylabel('y')\n",
    "ax.set_zlabel('z')\n",
    "ax.set_title('Figure 1.10 – Line of Intersection Between Two Planes')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
