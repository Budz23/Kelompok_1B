   "metadata": {},
   "source": [
    "### 1.1.3 CROSS PRODUCT"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "d6af6f2a",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 800x600 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from mpl_toolkits.mplot3d import Axes3D\n",
    "\n",
    "# Vektor a dan b (bukan searah)\n",
    "a = np.array([1, 1, 0])\n",
    "b = np.array([-1, 1, 0])\n",
    "\n",
    "# Perkalian silang a × b\n",
    "c = np.cross(a, b)\n",
    "\n",
    "# Visualisasi\n",
    "fig = plt.figure(figsize=(8, 6))\n",
    "ax = fig.add_subplot(111, projection='3d')\n",
    "\n",
    "# Panah vektor\n",
    "ax.quiver(0, 0, 0, *a, color='r', label='a', linewidth=2)\n",
    "ax.quiver(0, 0, 0, *b, color='g', label='b', linewidth=2)\n",
    "ax.quiver(0, 0, 0, *c, color='b', label='a × b', linewidth=2)\n",
    "\n",
    "# Anotasi label\n",
    "ax.text(*a, 'a', color='r', fontsize=12)\n",
    "ax.text(*b, 'b', color='g', fontsize=12)\n",
    "ax.text(*c, 'a×b', color='b', fontsize=12)\n",
    "\n",
    "# Set axis\n",
    "ax.set_xlim([-2, 2])\n",
    "ax.set_ylim([-2, 2])\n",
    "ax.set_zlim([0, 2])\n",
    "ax.set_xlabel('x')\n",
    "ax.set_ylabel('y')\n",
    "ax.set_zlabel('z')\n",
    "ax.set_title('Figure 1.6 – Direction of Cross Product: a × b')\n",
    "ax.legend()\n",
    "ax.view_init(elev=20, azim=45)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
