    "import numpy as np\n",
    "\n",
    "# Definisi matriks A dan vektor b\n",
    "A = np.array([[1, 2]])\n",
    "b = 3\n",
    "\n",
    "# Hitung solusi minimum-norm\n",
    "x_plus = A.T @ np.linalg.inv(A @ A.T) @ np.array([[b]])\n",
    "\n",
    "print(\"Solusi minimum-norm x+ =\\n\", x_plus)"
   ]
