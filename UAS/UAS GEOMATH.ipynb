    "import numpy as np\n",
    "\n",
    "A = np.array([[1, 2], [3, 4]])\n",
    "b = np.array([-1, -1])\n",
    "x = np.linalg.inv(A) @ b  # atau lebih efisien: x = np.linalg.solve(A, b)\n",
    "print(x)\n"
   ]
