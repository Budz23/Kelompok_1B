   "source": [
    "import numpy as np\n",
    "\n",
    "def gauss_elimination(A, b):\n",
    "    A = A.astype(float)  # pastikan float agar tidak error saat pembagian\n",
    "    b = b.astype(float)\n",
    "    n = len(b)\n",
    "\n",
    "    # Eliminasi Maju (Forward Elimination)\n",
    "    for k in range(n - 1):\n",
    "        if A[k, k] == 0:\n",
    "            for i in range(k + 1, n):\n",
    "                if A[i, k] != 0:\n",
    "                    A[[k, i]] = A[[i, k]]  # Tukar baris A\n",
    "                    b[[k, i]] = b[[i, k]]  # Tukar baris b\n",
    "                    break\n",
    "        for i in range(k + 1, n):\n",
    "            factor = A[i, k] / A[k, k]\n",
    "            A[i, k:] = A[i, k:] - factor * A[k, k:]\n",
    "            b[i] = b[i] - factor * b[k]\n",
    "\n",
    "    # Substitusi Balik (Backward Substitution)\n",
    "    x = np.zeros(n)\n",
    "    for i in range(n - 1, -1, -1):\n",
    "        sum_ax = np.dot(A[i, i + 1:], x[i + 1:])\n",
    "        x[i] = (b[i] - sum_ax) / A[i, i]\n",
    "    \n",
    "    return x\n",
    "\n",
    "# Contoh sistem\n",
    "# 0x1 + 1x2 + 1x3 = 2\n",
    "# 2x1 - 1x2 + 1x3 = 0\n",
    "# 1x1 - 1x2 + 1x3 = 1\n",
    "\n",
    "A = np.array([\n",
    "    [0, 1, 1],\n",
    "    [2, -1, 1],\n",
    "    [1, -1, 1]\n",
    "])\n",
    "\n",
    "b = np.array([2, 0, 1])\n",
    "\n",
    "# Jalankan eliminasi Gauss\n",
    "solusi = gauss_elimination(A, b)\n",
    "print(\"Solusi x:\", solusi)"
   ]
