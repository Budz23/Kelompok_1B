   "source": [
    "\n",
    "### Solusi Minimum-Norm\n",
    "\n",
    "Gunakan rumus minimum-norm\n",
    "\n",
    "$$\n",
    "x^+ = A^T (A A^T)^{-1} b\n",
    "\\tag{1.3.19}\n",
    "$$\n",
    "\n",
    "Substitusi nilai:\n",
    "\n",
    "$$\n",
    "x^+ =\n",
    "\\begin{bmatrix}\n",
    "1 \\\\\n",
    "2\n",
    "\\end{bmatrix}\n",
    "\\left(\n",
    "[1 \\quad 2]\n",
    "\\begin{bmatrix} 1 \\\\\n",
    "2\n",
    "\\end{bmatrix}\n",
    "\\right)^{-1}\n",
    "\\cdot 3\n",
    "=\n",
    "\\begin{bmatrix}\n",
    "1 \\\\\n",
    "2\n",
    "\\end{bmatrix}\n",
    "\\cdot \\frac{1}{5} \\cdot 3\n",
    "=\n",
    "\\frac{3}{5}\n",
    "\\begin{bmatrix}\n",
    "1 \\\\\n",
    "2\n",
    "\\end{bmatrix}\n",
    "=\n",
    "\\begin{bmatrix}\n",
    "0.6 \\\\\n",
    "1.2\n",
    "\\end{bmatrix}\n",
    "\\tag{1.3.20}\n",
    "$$"
   ]
  },
